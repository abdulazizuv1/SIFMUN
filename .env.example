# Copy this file to .env.local and fill in the values from the Firebase console:
# Project settings -> General -> Your apps -> Web app -> SDK setup and configuration.
# .env.local is ignored by git. These keys identify the project; access is protected
# by the Firestore security rules, not by keeping these values secret.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Photo uploads. Use ONE of the two options below.
# Option A, Firebase Storage (needs the Blaze plan): leave the Cloudinary values empty.
# Option B, Cloudinary free plan with an unsigned upload preset:
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
